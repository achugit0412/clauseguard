{
  "manifest_version": 3,
  "name": "ClauseGuard — ToS & Privacy Risk Analyzer",
  "version": "1.0.0",
  "description": "Analyzes Terms of Service and Privacy Policies in real time, warning you about risky clauses before you click 'I Agree'.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClauseGuard Legal Risk Summary"
  }
}
